{
  "functions": {
    "api/ai-meal.js": { "maxDuration": 30 },
    "api/scan-barcode.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "comment": "The app is a single HTML file. iOS caches it aggressively (especially when added to the home screen), which left users running an old build after a deploy. Always revalidate the shell.",
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "comment": "App scripts are loaded with a ?v= build stamp, so a new build always requests a new URL and these can be cached hard.",
      "source": "/(points-engine|food-db|week-engine).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
